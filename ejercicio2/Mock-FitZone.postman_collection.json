      "name": "01-DataDriven",
      "item": [
        {
          "name": "POST Crear socio desde CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const socio = pm.response.json();\r\n\r\nconst planValido = [\"BASICO\", \"PLUS\", \"PREMIUM\"];\r\nconst edadValida = socio.edad >= 16 && socio.edad <= 90;\r\nconst emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(socio.email);\r\n\r\nconst esperadoValido =\r\n    String(pm.iterationData.get(\"valido\")).toLowerCase() === \"true\";\r\n\r\nconst datosSonValidos =\r\n    planValido.includes(socio.plan) &&\r\n    edadValida &&\r\n    emailValido;\r\n\r\npm.test(\"La API responde con código 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"La validez de los datos coincide con el CSV\", function () {\r\n    pm.expect(datosSonValidos).to.eql(esperadoValido);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"{{nombre}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"plan\": \"{{plan}}\",\r\n  \"activo\": {{activo}},\r\n  \"edad\": {{edad}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/socios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "socios"
              ]
            }
          },
          "response": []
        },
