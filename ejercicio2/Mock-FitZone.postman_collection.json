    {
      "name": "03-Consultas",
      "item": [
        {
          "name": "GET - Listar socios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La consulta de socios responde con código 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta contiene una lista de socios\", function () {\r\n    const socios = pm.response.json();\r\n\r\n    pm.expect(socios).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"La lista de socios contiene registros\", function () {\r\n    const socios = pm.response.json();\r\n\r\n    pm.expect(socios.length).to.be.greaterThan(0);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/socios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "socios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - Buscar socio por ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = [1, 2, 3];\r\n\r\npm.environment.set(\r\n    \"idSocio\",\r\n    ids[pm.info.iteration]\r\n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La API responde con código 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"El ID del socio corresponde al solicitado\", function () {\r\n    const socio = pm.response.json();\r\n    const idEsperado = Number(pm.environment.get(\"idSocio\"));\r\n\r\n    pm.expect(socio.id).to.eql(idEsperado);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/socios/{{idSocio}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "socios",
                "{{idSocio}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - Listar socios por plan PLUS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const socios = pm.response.json();\r\n\r\npm.test(\"La consulta filtrada responde con código 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Todos los socios pertenecen al plan PLUS\", function () {\r\n    pm.expect(socios).to.be.an(\"array\");\r\n\r\n    socios.forEach(function (socio) {\r\n        pm.expect(socio.plan).to.eql(\"PLUS\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/socios?plan=PLUS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "socios"
              ],
              "query": [
                {
                  "key": "plan",
                  "value": "PLUS"
                }
              ]
            }
          },
          "response": []
        }
      ]
