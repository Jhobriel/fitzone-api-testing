      "name": "02-CRUD-Encadenado",
      "item": [
        {
          "name": "POST - Crear socio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La creación del socio responde con código 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"El socio creado tiene un ID\", function () {\r\n    const socio = pm.response.json();\r\n    pm.expect(socio.id).to.exist;\r\n});\r\n\r\npm.collectionVariables.set(\"socioId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"{{nombre}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"plan\": \"{{plan}}\",\r\n  \"activo\": {{activo}},\r\n  \"edad\": {{edad}}\r\n}   ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
